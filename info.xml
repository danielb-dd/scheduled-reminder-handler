<?xml version="1.0"?>
<extension key="schedulereminderhandler" type="module">
  <file>schedulereminderhandler</file>
  <name>Custom Schedule Reminder Handler</name>
  <description>This extension allows you to customize the schedule reminder handler for your organization.</description>
  <license>AGPL-3.0</license>
  <maintainer>
